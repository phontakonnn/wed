{
  "name": "wed-phontakon",
  "private": true,
  "version": "3.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "test:rules": "npm --prefix apps/web run test:rules",
    "test:rules:watch": "npm --prefix apps/web run test:rules:watch",
    "audit:mobile": "npm --prefix apps/web run audit:mobile",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:budget",
    "deploy:hosting": "firebase deploy --only hosting",
    "prepare": "git config core.hooksPath .githooks",
    "hooks:setup": "git config core.hooksPath .githooks"
  },
  "license": "MIT",
  "type": "module"
}
