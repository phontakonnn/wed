# ==============================================================================
# PKH / Life OS — Environment Configuration Template (.env)
# ==============================================================================

# 1. Server & Network
# พอร์ตการทำงานของ Fastify Server (ค่าเริ่มต้นคือ 3001)
PORT=3001
# ที่อยู่ IP ที่เซิร์ฟเวอร์จะรับคำขอ (0.0.0.0 สำหรับรับการเชื่อมต่อจากภายนอก/Docker)
HOST=0.0.0.0
# สภาพแวดล้อม: development หรือ production
NODE_ENV=production

# 2. Data Storage & Persistence
# โฟลเดอร์จัดเก็บฐานข้อมูล SQLite และไฟล์อัปโหลด
# หากรันบนเครื่อง Local: ./data
# หากรันบน Docker / VPS: /data
DATA_DIR=/data

# 3. Security & Origins (OWASP ASVS Compliance)
# โดเมนและ URL จริงของเว็บแอปพลิเคชัน (จำเป็นสำหรับตรวจสอบ CSRF และ Origin)
# ตัวอย่าง: https://brain.yourdomain.com หรือ http://127.0.0.1:3001
APP_ORIGIN=http://127.0.0.1:3001
EXPECTED_ORIGIN=http://127.0.0.1:3001

# 4. Admin Security Gate PIN
# รหัส PIN สำรองสำหรับปลดล็อกเข้าสู่ศูนย์ควบคุมระบบหลังบ้าน (/admin)
# หากไม่ระบุ ระบบจะใช้รหัสผ่าน Scrypt ของบัญชีผู้ใช้ หรือรหัสที่ตั้งไว้ในระบบ
ADMIN_GATE_PIN=123456

# 5. Cloud & Distributed Replications (Optional)
# หากต้องการเชื่อมต่อกับ LiteFS หรือ Cloud Volumes
# LITEFS_DIR=/litefs/data
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
