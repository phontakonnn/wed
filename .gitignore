# ---------------------------------------------------------------------------
# Personal Knowledge Hub — Git ignore rules
# Rule of thumb: never commit runtime data, secrets, or build output.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# Build output
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
**/.cache/
**/tmp/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Local runtime noise
# ---------------------------------------------------------------------------
**/logs/
*.log

# Defensive: any SQLite database accidentally dropped in the tree
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm

# Defensive: stray backups / editor swap files
*.backup
*.bak

# ---------------------------------------------------------------------------
# Acceptance test temporary profiles and runtime runs
# ---------------------------------------------------------------------------
.tmp-acceptance*/
tmp-acceptance*/
test-results/
**/test-results/
playwright-report/
**/playwright-report/

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
secrets/
.secret/
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------------------------------------------------------------------------
# Local agent workspace (personal notes / memory, not application code)
# ---------------------------------------------------------------------------
.workbuddy-ai/

# ---------------------------------------------------------------------------
# Defensive: absolute Windows paths accidentally pasted into the tree
# ---------------------------------------------------------------------------
D:\*
E:\*

# Firebase CLI cache
.firebase/
