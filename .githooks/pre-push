#!/usr/bin/env sh
# PKH / Life OS pre-push hook
# Prevents broken code from being pushed to the remote repository.

set -e

echo "=================================================="
echo "🔍 Running pre-push quality gates for Life OS..."
echo "=================================================="

echo "➡️ [1/4] Typecheck (tsc -b)..."
npm --prefix apps/web run typecheck

echo "➡️ [2/4] Lint (eslint)..."
npm --prefix apps/web run lint

echo "➡️ [3/4] Unit tests (vitest)..."
npm --prefix apps/web run test

echo "➡️ [4/4] Build + bundle budget..."
npm --prefix apps/web run build
node scripts/check-bundle-budget.mjs

echo "=================================================="
echo "✅ All pre-push quality gates passed! Pushing code..."
echo "=================================================="
exit 0
