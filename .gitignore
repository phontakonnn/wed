# ---------------------------------------------------------------------------
# Personal Knowledge Hub — Git ignore rules
# Rule of thumb: never commit runtime data, secrets, or build output.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# Build output
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
**/.cache/
**/tmp/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Runtime data (DATA_DIR) — NEVER commit
# Production layout: DATA_DIR/db/knowledge.sqlite3
# ---------------------------------------------------------------------------
**/db/knowledge.sqlite3
**/db/knowledge.sqlite3-wal
**/db/knowledge.sqlite3-shm
**/data/
**/objects/
**/uploads/
**/logs/
*.log

# Any SQLite database anywhere in the tree
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm

# Backups and restore artefacts
**/backups/
*.backup
*.bak
*.pre-restore-*

# ---------------------------------------------------------------------------
# Acceptance test temporary profiles and runtime runs
# ---------------------------------------------------------------------------
.tmp-acceptance*/
tmp-acceptance*/

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
secrets/
.secret/
credentials.json
service-account*.json

# Machine-specific backup paths (generated by scripts/register-backup-task.ps1)
scripts/backup-config.cmd

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------------------------------------------------------------------------
# Local agent workspace (personal notes / memory, not application code)
# ---------------------------------------------------------------------------
.workbuddy-ai/

# ---------------------------------------------------------------------------
# Defensive: absolute Windows paths accidentally pasted into the tree
# ---------------------------------------------------------------------------
D:\*
E:\*
