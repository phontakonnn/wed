# ==============================================================================
# Firebase-first PWA — environment template
# Copy to .env.local for local development. Never commit real .env files.
# ==============================================================================

# 1. Firebase Web SDK (public identifiers, one set per environment)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 2. App Check (reCAPTCHA Enterprise/v3 site key)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Local-only debug token; register it in Firebase Console → App Check → Debug tokens.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# 3. Web Push (FCM VAPID public key, safe to expose)
VITE_FIREBASE_VAPID_KEY=

# 4. Optional: Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
