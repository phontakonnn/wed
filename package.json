{
  "name": "wed-phontakon",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:server": "npm --prefix apps/server run dev",
    "build:server": "npm --prefix apps/server run build",
    "start:server": "npm --prefix apps/server start",
    "bootstrap:admin": "npm --prefix apps/server run bootstrap:admin",
    "backup:create": "npm --prefix apps/server run backup:create --",
    "backup:list": "npm --prefix apps/server run backup:list --",
    "backup:verify": "npm --prefix apps/server run backup:verify --",
    "backup:restore": "npm --prefix apps/server run backup:restore --",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/server run test",
    "storage:check": "npm --prefix apps/server run storage:check --",
    "storage:quarantine": "npm --prefix apps/server run storage:quarantine --",
    "backup:preflight": "npm --prefix apps/server run backup:preflight --",
    "backup:staging": "npm --prefix apps/server run backup:staging --",
    "test:e2e": "npm --prefix apps/web run test:e2e"
  },
  "license": "MIT",
  "type": "module"
}